# Application
APP_NAME=School Operations Agent Platform
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-hex-secret-in-production
DATABASE_PATH=./data/school_ops.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880

# Model / Parsing Provider ("deterministic" works offline with zero external keys; "openai" optional)
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PROMPT_VERSION=v1.0

# Chat Channels (optional for local simulator; required for live Telegram/WhatsApp webhooks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-secret
WHATSAPP_VERIFY_TOKEN=change-me-whatsapp-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Feature Flags
FEATURE_QUIET_HOURS_ENFORCED=true
FEATURE_AUTO_ESCALATE_BLOCKED=true
FEATURE_STRICT_PROMPT_GUARD=true
FEATURE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security & Rate Limiting
SESSION_TTL_HOURS=24
INVITE_TTL_HOURS=48
RATE_LIMIT_PER_MINUTE=120
